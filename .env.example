# Postgres. The evals only ever touch TEST_DATABASE_URL, and refuse to run unless
# its database name ends in _test.
DATABASE_URL=postgresql://localhost:5432/receptionist
TEST_DATABASE_URL=postgresql://localhost:5432/receptionist_test

# Claude. Optional if you have run `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
JUDGE_MODEL=claude-opus-5-5

# Clinic
CLINIC_NAME=Artic Maze Clinic
CLINIC_TZ=Asia/Dhaka
PORT=3000

# Calendar: "fake" runs on in-memory demo slots, "calcom" uses the real API.
CALENDAR_ADAPTER=fake
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v2
# One event type per provider, as JSON:
# [{"id":"dr_karim","name":"Dr. Karim","nameBn":"ডা. করিম","specialty":"General Medicine","eventTypeId":123}]
CALCOM_PROVIDERS=[]
# Attendee emails are synthetic (patient-<id>@<domain>) and used to look up a
# patient's bookings. Use a domain you control, or disable Cal.com attendee email.
CALCOM_ATTENDEE_EMAIL_DOMAIN=patients.example.com

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Vapi: the shared secret Vapi sends as a bearer token or X-Vapi-Secret.
VAPI_SECRET=
