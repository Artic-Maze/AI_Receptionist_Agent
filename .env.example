# Postgres. These match docker-compose.dev.yml; point them at your own server if you
# have one. The evals only ever touch TEST_DATABASE_URL, and refuse to run unless
# its database name ends in _test.
DATABASE_URL=postgresql://receptionist:receptionist@localhost:5433/receptionist
TEST_DATABASE_URL=postgresql://receptionist:receptionist@localhost:5433/receptionist_test

# Claude. Optional if you have run `ant auth login`.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
JUDGE_MODEL=claude-opus-5-5

# Clinic
CLINIC_NAME=Artic Maze Clinic
CLINIC_TZ=Asia/Dhaka
PORT=3000
# Only behind a proxy: the addresses it connects from, so the rate limits can read
# each visitor's address from X-Forwarded-For. docker-compose.yml sets "uniquelocal"
# for Traefik. Leave it empty when the app faces the internet itself.
TRUST_PROXY=

# Calendar: "db" is the demo calendar, with doctors, weekly hours and bookings kept
# in Postgres (run `npm run db:seed` for the demo doctors). "calcom" uses the real API.
CALENDAR_ADAPTER=db
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v2
# One event type per provider, as JSON:
# [{"id":"dr_karim","name":"Dr. Karim","nameBn":"ডা. করিম","specialty":"General Medicine","eventTypeId":123}]
CALCOM_PROVIDERS=[]
# Attendee emails are synthetic (patient-<id>@<domain>) and used to look up a
# patient's bookings. Use a domain you control, or disable Cal.com attendee email.
CALCOM_ATTENDEE_EMAIL_DOMAIN=patients.example.com

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Vapi voice calls. VAPI_SECRET is shared with Vapi, which sends it on every request
# here, as a bearer token or X-Vapi-Secret: any long random string.
VAPI_SECRET=
# The https address Vapi reaches this server at. Vapi refuses localhost.
PUBLIC_URL=
# Private key, only for `npm run vapi:assistant -- --push`. Keep it off the server.
VAPI_API_KEY=
# Set both to show a call button on the homepage. Restrict the public key to your
# site's origin and this assistant in the Vapi dashboard.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Model effort on calls, where thinking time is silence: low | medium | high
LLM_VOICE_EFFORT=low
# Optional, as JSON in Vapi's format, to replace the default speech recognition or voice.
# The defaults are Deepgram Flux in English and Spanish, and ElevenLabs Flash v2.5.
# VAPI_TRANSCRIBER={"provider":"deepgram","model":"flux-general-en"}
# VAPI_VOICE={"provider":"11labs","model":"eleven_flash_v2_5","voiceId":"sarah"}
